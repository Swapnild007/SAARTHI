# Explicitly configure each deployment. Scope, credentials and provider budgets
# belong to that deployment, never to the frontend bundle.
SAARTHI_ENV=local
SAARTHI_ORIGIN=http://127.0.0.1:8000
SAARTHI_COMMIT_SHA=
SAARTHI_OWNER_ID=
SAARTHI_OWNER_PASSWORD=
SAARTHI_SESSION_KEY=
SAARTHI_DAILY_TURNS=100
SAARTHI_RATE_LIMIT_PER_MINUTE=60

# Apply database/recovery.sql and set the matching singleton scope before use.
SAARTHI_SUPABASE_URL=
SAARTHI_SUPABASE_SERVICE_ROLE_KEY=

SAARTHI_LLM_API_URL=https://openrouter.ai/api/v1
SAARTHI_LLM_API_KEY=
SAARTHI_LLM_MODEL=openrouter/free
SAARTHI_LLM_REQUEST_TIMEOUT_SECONDS=7

# Keep disabled until the exact restricted gateway passes live staging checks.
SAARTHI_HERMES_ENABLED=false
SAARTHI_HERMES_VALIDATED_SCOPE=
SAARTHI_HERMES_URL=
SAARTHI_HERMES_API_KEY=

# Hosted settings use SAARTHI_PREVIEW_, SAARTHI_STAGING_, or SAARTHI_PRODUCTION_.
# Set SAARTHI_ENV and SAARTHI_ORIGIN separately in the deployment environment.
# A hosted deployment has no access to legacy unscoped credential variables.
# SAARTHI_STAGING_OWNER_ID=
# SAARTHI_STAGING_OWNER_PASSWORD=
# SAARTHI_STAGING_SESSION_KEY=
# SAARTHI_STAGING_SUPABASE_PROJECT_REF=
# SAARTHI_STAGING_SUPABASE_URL=
# SAARTHI_STAGING_SUPABASE_SERVICE_ROLE_KEY=
# SAARTHI_STAGING_LLM_ROUTES_JSON=
# SAARTHI_STAGING_LLM_HARD_CAP_CONFIRMED=
# SAARTHI_STAGING_LLM_TURN_RESERVE_MICRO_USD=
# SAARTHI_STAGING_DAILY_BUDGET_MICRO_USD=
# SAARTHI_STAGING_MONTHLY_BUDGET_MICRO_USD=
