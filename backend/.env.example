# Cloud LLM adapter (server-side only; never expose these in browser code)
SAARTHI_LLM_API_URL=https://openrouter.ai/api/v1
SAARTHI_LLM_API_KEY=
SAARTHI_LLM_MODEL=openrouter/free

# Comma-separated frontend origins
SAARTHI_ALLOWED_ORIGINS=http://localhost:5173

# Managed RAG: Supabase Postgres with pgvector + OpenAI-compatible embeddings.
# Run database/rag_schema.sql once in the Supabase SQL editor.
SAARTHI_SUPABASE_URL=
SAARTHI_SUPABASE_SERVICE_ROLE_KEY=
SAARTHI_EMBEDDING_API_URL=https://api.openai.com/v1
SAARTHI_EMBEDDING_API_KEY=
SAARTHI_EMBEDDING_MODEL=text-embedding-3-small
SAARTHI_KNOWLEDGE_ADMIN_TOKEN=

# Remote MCP endpoints only. No SAARTHI-owned MCP server is required.
# Each entry must use HTTPS and explicitly allowlist tool names.
# token_env points to a separate environment variable, never put token values in this JSON.
# Set allow_write=true only after reviewing the remote tools and granting explicit permission.
SAARTHI_MCP_SERVERS_JSON=[]
SAARTHI_MCP_TIMEOUT_SECONDS=1.5

# AppForge isolated builds. Configure only on the private preview branch until user auth is complete.
APPFORGE_BUILD_TOKEN=
