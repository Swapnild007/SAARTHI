{
  "name": "saarthi",
  "version": "1.0.0-dev",
  "private": true,
  "scripts": {
    "build": "node scripts/validate-release.cjs",
    "test": "python -m pytest -q backend tests",
    "test:e2e": "node tests/e2e/smoke.cjs",
    "test:offline": "node tests/e2e/offline.cjs",
    "test:a11y": "node tests/e2e/accessibility.cjs",
    "test:pwa": "node tests/e2e/pwa.cjs",
    "android:prepare": "node scripts/prepare-android.cjs && npx cap sync android",
    "android:build": "npm run android:prepare && cd android && ./gradlew assembleDebug testDebugUnitTest",
    "test:assistant": "node --test tests/assistant.test.cjs",
    "test:capabilities": "node tests/e2e/capabilities.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "^7.6.9",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/network": "^7.0.4"
  }
}
